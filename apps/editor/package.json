{
  "name": "atlas-editor",
  "version": "0.9.0",
  "description": "Local repository editor and reader for Atlas",
  "private": true,
  "type": "module",
  "license": "CC0-1.0 OR 0BSD",
  "bin": {
    "atlas-editor": "bin/atlas-editor.mjs"
  },
  "exports": {
    ".": "./src/server.mjs"
  },
  "files": [
    "README.md",
    "LICENSE",
    "LICENSE.CC0-1.0",
    "LICENSE.0BSD",
    "bin",
    "src",
    "public"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "atlas-reference-validator": "workspace:*",
    "github-slugger": "2.0.0",
    "markdown-it": "14.3.0",
    "atlas-portal": "workspace:*"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
