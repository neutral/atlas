---
import type { PortalProps } from '../core/types';
interface Props extends PortalProps {}
const { corpus, route } = Astro.props;
const mapById = new Map(corpus.maps.map((map) => [map.id, map]));
const pointById = new Map(corpus.points.map((point) => [point.id, point]));
const currentPoint = route.kind === 'point' ? pointById.get(route.pointId) : null;
const currentResource = route.kind === 'resource' ? corpus.resources.find((resource) => resource.id === route.resourceId) : null;
const overlaps = route.kind === 'map' ? corpus.relatedMaps.filter((item) => item.maps.includes(route.mapId)) : [];
---

{overlaps.length > 0 && (
  <section class="reader-connections" aria-labelledby="related-maps">
    <div class="section-heading-row"><h2 id="related-maps">Related Maps</h2><span>Shared selected Points</span></div>
    <ul class="context-link-list">
      {overlaps.map((overlap) => {
        const currentMapId = 'mapId' in route ? route.mapId : undefined;
        const otherId = overlap.maps[0] === currentMapId ? overlap.maps[1] : overlap.maps[0];
        return <li><a href={`/maps/${otherId}/`}><strong>{mapById.get(otherId)?.title ?? otherId}</strong><span>{overlap.pointIds.length} shared {overlap.pointIds.length === 1 ? 'Point' : 'Points'}</span></a></li>;
      })}
    </ul>
  </section>
)}

{route.kind === 'point' && currentPoint && (currentPoint.relations.length > 0 || currentPoint.incomingRelations.length > 0) && (
  <section class="reader-connections" aria-labelledby="point-relations">
    <div class="section-heading-row"><h2 id="point-relations">Relations</h2><span>{currentPoint.relations.length + currentPoint.incomingRelations.length} connections</span></div>
    <ul class="relation-list">
      {currentPoint.relations.map((relation) => {
        const target = pointById.get(relation.targetPoint);
        return <li><span class="relation-type">{relation.type}</span><div>{target ? <a href={`/points/${target.id}/`}>{target.title}</a> : <strong>{relation.targetPoint}</strong>}<p>{relation.note}</p></div></li>;
      })}
      {currentPoint.incomingRelations.map((relation) => <li><span class="relation-type">{relation.type} from</span><div><a href={`/points/${relation.sourcePoint}/`}>{pointById.get(relation.sourcePoint)?.title ?? relation.sourcePoint}</a><p>{relation.note}</p></div></li>)}
    </ul>
  </section>
)}

{route.kind === 'resource' && currentResource && (
  <section class="reader-connections" aria-labelledby="resource-uses">
    <div class="section-heading-row"><h2 id="resource-uses">Where this Resource is used</h2><span>{currentResource.uses.length} uses</span></div>
    {currentResource.uses.length === 0
      ? <p class="empty-note">This Resource is included directly. No selected Atlas, Map, Area, or Point record links to it.</p>
      : <ul class="explanation-list">
          {currentResource.uses.map((use) => {
            const mapTitle = (use.source.kind === 'point-record' || use.source.kind === 'area')
              ? mapById.get(use.source.mapId)?.title ?? use.source.mapId
              : null;
            return <li><a href={use.source.route} aria-label={mapTitle ? `${use.source.title} in ${mapTitle}` : undefined}>{use.source.title}</a><p>{mapTitle && <span>In {mapTitle} · </span>}{use.use === 'content' ? 'Primary material' : use.role}{use.note ? ` · ${use.note}` : ''}</p></li>;
          })}
        </ul>}
  </section>
)}

{route.kind === 'search' && (
  <section class="reader-connections search-boundary" aria-label="Search meaning">
    <p>Search covers this publication’s Maps, Areas, Points, and Resources. Long Resources are searched through indexed excerpts. Open a Resource to read its complete available text. Results preserve one identity per Point and Resource. Text matches do not establish semantic connections.</p>
  </section>
)}
