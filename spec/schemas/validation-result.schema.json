{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schema:validation-result:1",
  "type": "object",
  "required": ["profile", "complete", "valid", "specificationRevision", "implementation", "diagnostics"],
  "properties": {
    "profile": { "type": "string", "minLength": 1 },
    "complete": { "type": "boolean" },
    "valid": { "type": "boolean" },
    "specificationRevision": { "type": "string", "minLength": 1 },
    "implementation": {
      "type": "object",
      "required": ["name", "version", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["working", "stable"] }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "normalized": { "$ref": "urn:atlas:schema:normalized:1" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "valid": { "const": true } }, "required": ["valid"] },
      "then": {
        "properties": {
          "complete": { "const": true },
          "diagnostics": {
            "type": "array",
            "not": { "contains": { "type": "object", "properties": { "severity": { "const": "error" } }, "required": ["severity"] } }
          }
        }
      },
      "else": {
        "properties": {
          "diagnostics": {
            "type": "array",
            "contains": { "type": "object", "properties": { "severity": { "const": "error" } }, "required": ["severity"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "normalized": true }, "required": ["normalized"] },
      "then": {
        "properties": {
          "profile": { "const": "neutral.atlas-validator.resolved" },
          "complete": { "const": true },
          "valid": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": { "const": "neutral.atlas-validator.resolved" },
          "complete": { "const": true },
          "valid": { "const": true }
        },
        "required": ["profile", "complete", "valid"]
      },
      "then": { "properties": { "normalized": true }, "required": ["normalized"] }
    },
    {
      "if": { "properties": { "complete": { "const": false } }, "required": ["complete"] },
      "then": { "properties": { "valid": { "const": false } } }
    }
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^atlas\\.[a-z0-9.-]+$" },
        "severity": { "enum": ["error", "warning", "information"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "details": true
      },
      "additionalProperties": false
    }
  }
}
