{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schema:catalog:2",
  "type": "object",
  "properties": {
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "maps"
        ],
        "properties": {
          "title": {
            "$ref": "urn:atlas:schema:common:1#/$defs/nonBlankString"
          },
          "maps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
            }
          }
        },
        "patternProperties": {
          "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
        },
        "additionalProperties": false
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "map": {
            "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
          },
          "id": {
            "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
          },
          "title": {
            "$ref": "urn:atlas:schema:common:1#/$defs/nonBlankString"
          }
        },
        "additionalProperties": false,
        "required": [
          "map",
          "id",
          "title"
        ],
        "patternProperties": {
          "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "urn:atlas:schema:common:1#/$defs/resource"
      }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "point": {
            "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "anyOf": [
                {
                  "enum": [
                    "decision",
                    "constraint",
                    "observation",
                    "question",
                    "proposal",
                    "direction",
                    "implementation",
                    "requirement",
                    "risk",
                    "goal",
                    "practice"
                  ]
                },
                {
                  "$ref": "urn:atlas:schema:common:1#/$defs/extensionIdentifier"
                }
              ]
            }
          },
          "review": {
            "$ref": "urn:atlas:schema:common:1#/$defs/review"
          }
        },
        "additionalProperties": false,
        "required": [
          "point"
        ],
        "patternProperties": {
          "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
          },
          "level": {
            "enum": [
              "required",
              "advisory"
            ]
          },
          "applies-to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "atlas",
                "map",
                "area",
                "point-anchor",
                "point-context",
                "resource",
                "check",
                "publication"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "check",
          "level",
          "applies-to"
        ],
        "patternProperties": {
          "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "atlas"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "map"
                  },
                  "map": {
                    "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "map"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "area"
                  },
                  "map": {
                    "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
                  },
                  "area": {
                    "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "map",
                  "area"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "point"
                  },
                  "map": {
                    "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
                  },
                  "point": {
                    "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "map",
                  "point"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "check"
                  },
                  "check": {
                    "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "check"
                ]
              }
            ]
          },
          "values": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false,
        "required": [
          "owner",
          "values"
        ]
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
  }
}
