{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schema:atlas:1",
  "type": "object",
  "required": [
    "type",
    "format",
    "id",
    "title",
    "summary"
  ],
  "properties": {
    "type": {
      "const": "atlas"
    },
    "format": {
      "const": 1
    },
    "id": {
      "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
    },
    "title": {
      "$ref": "urn:atlas:schema:common:1#/$defs/nonBlankString"
    },
    "summary": {
      "$ref": "urn:atlas:schema:common:1#/$defs/summary"
    },
    "navigation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "maps"
        ],
        "properties": {
          "title": {
            "$ref": "urn:atlas:schema:common:1#/$defs/nonBlankString"
          },
          "maps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:atlas:schema:common:1#/$defs/identifier"
            }
          }
        },
        "patternProperties": {
          "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:atlas:schema:common:1#/$defs/resource"
      }
    },
    "content": {
      "$ref": "urn:atlas:schema:common:1#/$defs/contentList"
    },
    "references": {
      "$ref": "urn:atlas:schema:common:1#/$defs/referenceList"
    }
  },
  "patternProperties": {
    "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
  },
  "additionalProperties": false
}
