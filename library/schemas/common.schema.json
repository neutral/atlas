{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schema:common:1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "extensionIdentifier": {
      "type": "string",
      "pattern": "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "selector": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contentTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "resource"
          ],
          "properties": {
            "resource": {
              "$ref": "#/$defs/identifier"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "label": {
              "$ref": "#/$defs/nonBlankString"
            }
          },
          "patternProperties": {
            "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "uri"
          ],
          "properties": {
            "uri": {
              "$ref": "#/$defs/nonBlankString"
            },
            "label": {
              "$ref": "#/$defs/nonBlankString"
            }
          },
          "patternProperties": {
            "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
          },
          "additionalProperties": false
        }
      ]
    },
    "referenceRole": {
      "enum": [
        "evidence",
        "supporting",
        "implementation",
        "historical",
        "example"
      ]
    },
    "resource": {
      "type": "object",
      "required": [
        "id",
        "uri",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "uri": {
          "$ref": "#/$defs/nonBlankString"
        },
        "title": {
          "$ref": "#/$defs/nonBlankString"
        },
        "media-type": {
          "$ref": "#/$defs/nonBlankString"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "reviewed-at": {
          "type": "string",
          "format": "date"
        },
        "review-after": {
          "type": "string",
          "format": "date"
        },
        "by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        }
      },
      "patternProperties": {
        "^x-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": true
      },
      "additionalProperties": false
    }
  }
}
