{
  "name": "atlas-reference-validator",
  "version": "0.9.0",
  "description": "Reference validator for Atlas format 2",
  "private": true,
  "type": "module",
  "types": "./src/index.d.ts",
  "license": "CC0-1.0 OR 0BSD",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
