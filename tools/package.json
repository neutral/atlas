{
  "name": "atlas-tools",
  "version": "0.7.0",
  "description": "Isolated workspace for Atlas Portal and the Atlas reference validator",
  "private": true,
  "type": "module",
  "license": "CC0-1.0",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "test": "pnpm --filter atlas-reference-validator test && pnpm --filter atlas-portal test",
    "test:portal": "pnpm --filter atlas-portal test",
    "test:validator": "pnpm --filter atlas-reference-validator test",
    "audit:dependencies": "pnpm audit --audit-level moderate"
  },
  "devDependencies": {
    "atlas-reference-validator": "workspace:*"
  },
  "engines": {
    "node": ">=22.23.2",
    "pnpm": "11.22.0"
  }
}
