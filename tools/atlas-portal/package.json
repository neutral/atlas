{
  "name": "atlas-portal",
  "version": "0.8.0",
  "description": "Static reader and site generator for Atlas",
  "private": true,
  "type": "module",
  "license": "CC0-1.0 OR 0BSD",
  "bin": {
    "atlas-portal": "src/cli/index.mjs",
    "atlas-portal-cloudflare": "src/cloudflare/cli.mjs"
  },
  "scripts": {
    "dev": "node src/cli/index.mjs dev",
    "build": "node src/cli/index.mjs build",
    "preview": "node src/cli/index.mjs preview",
    "cloudflare:dev": "node src/cloudflare/cli.mjs dev",
    "cloudflare:build": "node src/cloudflare/cli.mjs build",
    "cloudflare:deploy": "node src/cloudflare/cli.mjs deploy",
    "cloudflare:deploy:dry-run": "node src/cloudflare/cli.mjs deploy --dry-run",
    "test": "node --test tests/*.test.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@lucide/astro": "1.33.0",
    "astro": "7.2.4",
    "atlas-reference-validator": "workspace:*",
    "github-slugger": "2.0.0",
    "markdown-it": "14.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "wrangler": "4.125.0",
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "@types/node": "22.20.1",
    "@types/markdown-it": "14.2.0"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
