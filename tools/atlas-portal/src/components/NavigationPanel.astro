---
import type { PortalProps } from '../core/types';
interface Props extends PortalProps {}
import { Search, ChevronDown } from '@lucide/astro';

const { corpus, route } = Astro.props;
const currentPoint = route.kind === 'point' ? corpus.points.find((point) => point.id === route.pointId) : null;
const currentResource = route.kind === 'resource' ? corpus.resources.find((resource) => resource.id === route.resourceId) : null;
const currentMapId = 'mapId' in route ? route.mapId : currentPoint?.primaryMap ?? null;
const relatedMapIds = new Set([
  ...(currentPoint?.records.map((record) => record.map) ?? []),
  ...(currentResource?.uses.map((use) => ('mapId' in use.source ? use.source.mapId : undefined)).filter((item) => item !== undefined) ?? []),
]);
const mapById = new Map(corpus.maps.map((map) => [map.id, map]));
const authoredGroups = corpus.atlas.navigation
  .map((group) => ({ ...group, maps: group.maps.map((id) => mapById.get(id)).filter((item) => item !== undefined) }))
  .filter((group) => group.maps.length > 0);
const groupedMapIds = new Set(authoredGroups.flatMap((group) => group.maps.map((map) => map.id)));
const ungroupedMaps = corpus.maps.filter((map) => !groupedMapIds.has(map.id));
const groups = ungroupedMaps.length > 0 ? [...authoredGroups, { title: 'Other Maps', maps: ungroupedMaps }] : authoredGroups;
---

<div class="panel-heading navigation-heading">
  <a class="atlas-wordmark" href="/" aria-label={`${corpus.portal.name} home`}>
    <span class="atlas-mark" aria-hidden="true">A</span>
    <span>
      <strong>{corpus.portal.name}</strong>
      <small>Explore this Atlas</small>
    </span>
  </a>
</div>

<form class="nav-search" action="/search/" role="search">
  <Search size={15} stroke-width={1.7} aria-hidden="true" />
  <input name="q" type="search" placeholder="Search this Atlas" aria-label="Search this Atlas" data-global-search />
  <kbd>/</kbd>
</form>

<div class="navigation-groups">
  <a class:list={['navigation-link', 'overview-link', { active: route.kind === 'atlas' }]} href="/" aria-current={route.kind === 'atlas' ? 'page' : undefined}>Overview</a>
  {groups.map((group) => (
    <section class="navigation-group" aria-labelledby={`nav-${group.title.replace(/\W+/gu, '-').toLowerCase()}`}>
      <h2 id={`nav-${group.title.replace(/\W+/gu, '-').toLowerCase()}`}>{group.title}</h2>
      <ul>
        {group.maps.map((map) => {
          const active = 'mapId' in route && route.mapId === map.id;
          const related = relatedMapIds.has(map.id);
          const showAreas = currentMapId === map.id;
          return (
            <li>
              <div class="navigation-map-row">
              <a class:list={['navigation-link', { active, related }]} href={`/maps/${map.id}/`} aria-current={active && route.kind === 'map' ? 'page' : undefined}>
                <span>{map.title}</span>
              </a>
              <button class="area-toggle icon-button" type="button" data-toggle-areas aria-expanded={showAreas ? 'true' : 'false'} aria-controls={`nav-areas-${map.id}`} aria-label={`Areas in ${map.title}`}><ChevronDown size={14} aria-hidden="true" /></button>
              </div>
                <ul class="area-navigation" id={`nav-areas-${map.id}`} hidden={!showAreas}>
                  {map.areas.map((area) => {
                    const areaActive = route.kind === 'area' && route.mapId === map.id && route.areaId === area.id;
                    return (
                      <li>
                        <a class:list={['area-navigation-link', { active: areaActive }]} href={`/maps/${map.id}/areas/${area.id}/`} aria-current={areaActive ? 'page' : undefined}>
                          {area.title}
                        </a>
                      </li>
                    );
                  })}
                </ul>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>

<div class="navigation-footer">
  <a class:list={{ active: route.kind === 'search' }} href="/search/" aria-current={route.kind === 'search' ? 'page' : undefined}>Search <Search size={13} aria-hidden="true" /></a>
</div>
